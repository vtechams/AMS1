{
  "name": "academy-management-system",
  "version": "1.0.0",
  "description": "Production-grade Academy Management System (AMS) powered by an Excel Database Core",
  "scripts": {
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "start": "node backend/server.js",
    "init-db": "cd backend && npm run init-db",
    "test-e2e": "cd backend && node scripts/testE2E.js",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": [
    "ams",
    "academy",
    "excel",
    "react",
    "nodejs",
    "express"
  ],
  "author": "Antigravity Senior Full-Stack Architecture",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0"
  }
}
